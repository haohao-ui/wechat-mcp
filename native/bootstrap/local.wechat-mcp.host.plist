<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.wechat-mcp.host</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/微信客服助手.app/Contents/MacOS/wechat-cs-host</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- 宿主退出时要先停止核心（核心可能正在完成一轮回复，宿主最多等 240 秒） -->
    <key>ExitTimeOut</key>
    <integer>300</integer>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.wechat-rpa/logs/host.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.wechat-rpa/logs/host.stderr.log</string>
</dict>
</plist>
