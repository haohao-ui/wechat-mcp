{
  "schema": 1,
  "wechat_version": "4.1.15",
  "window": {
    "width": 880,
    "height": 640
  },
  "regions": {
    "session_list": {
      "x": 60,
      "y": 60,
      "w": 240,
      "h": 580
    },
    "title": {
      "x": 250,
      "y": 0,
      "w": 620,
      "h": 50
    },
    "chat": {
      "x": 315,
      "y": 60,
      "w": 565,
      "h": 436
    },
    "input": {
      "x": 315,
      "y": 496,
      "w": 565,
      "h": 144
    }
  },
  "session_row": {
    "height": 64,
    "name_offset": 12,
    "time_min_x_ratio": 0.75
  },
  "themes": {
    "wechat-4-dark": {
      "background_max": 37,
      "incoming": [38, 82],
      "own": "green"
    },
    "wechat-4-light": {
      "background": [250, 250, 250],
      "background_min": 246,
      "incoming": [228, 244],
      "own": "green"
    }
  },
  "menu_labels": {
    "save_as": [
      "另存为…",
      "另存为...",
      "另存为",
      "存储为…",
      "Save As…",
      "Save As..."
    ],
    "copy_link": [
      "复制链接"
    ]
  },
  "scroll": {
    "lines_per_tick": 10,
    "points_per_tick": 90
  },
  "anchors": [
    {
      "name": "input_divider",
      "region": "chat",
      "edge": "bottom",
      "kind": "horizontal_line"
    },
    {
      "name": "list_border",
      "region": "session_list",
      "edge": "right",
      "kind": "vertical_line"
    },
    {
      "name": "title_text",
      "region": "title",
      "kind": "text_present"
    }
  ]
}
